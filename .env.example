# Copy to .env.local. Never commit credentials. Leave disabled until configured.
CONTACT_ENABLED=false
RESEND_API_KEY=
# A sender on your verified Resend domain. The recipient is server-controlled.
CONTACT_FROM=WD Marketing <website@wdmarketing.co.uk>
CONTACT_TO=hello@wdmarketing.co.uk
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=wdmarketing.co.uk
# Optional exact preview origins, comma-separated; never use a wildcard.
CONTACT_ALLOWED_ORIGINS=
