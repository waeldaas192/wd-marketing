# Copy to .env.local. Never commit credentials. Leave disabled until configured.
CONTACT_ENABLED=false
RESEND_API_KEY=
# A sender on your verified Resend domain. The recipient is server-controlled.
CONTACT_FROM=WD Marketing <website@wdmarketing.co.uk>
CONTACT_TO=hello@wdmarketing.co.uk
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=wdmarketing.co.uk
# Optional exact preview origins, comma-separated; never use a wildcard.
CONTACT_ALLOWED_ORIGINS=

# Public measurement identifiers (not passwords). GA4 is installed through GTM only.
# Import/configure docs/gtm first, then set enabled=true and rebuild.
NEXT_PUBLIC_MEASUREMENT_ENABLED=false
NEXT_PUBLIC_GTM_ID=GTM-MJL3LG77
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Website operator details. Use the confirmed legal name and correspondence address.
WD_LEGAL_NAME=
WD_CORRESPONDENCE_ADDRESS=
WD_COMPANY_NUMBER=
