{
  "name": "wd-marketing-premium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:turbo": "next dev --turbopack",
    "build": "next build && node scripts/build-worker.cjs",
    "start": "wrangler dev --config wrangler.generated.json",
    "build:mb-legacy-assets": "node scripts/build-mb-legacy-assets.cjs",
    "typecheck": "tsc --noEmit",
    "test:backend": "node qa/contact-worker.cjs && node qa/contact-runtime.cjs",
    "test:deployment": "node qa/standalone.cjs",
    "configure:cloudflare": "node scripts/cloudflare-config.cjs",
    "deploy": "node scripts/deploy-cloudflare.cjs",
    "test:measurement": "node qa/measurement.cjs",
    "test:mb-legacy": "node qa/mb-legacy-case-study.cjs",
    "test:workflow-docs": "node qa/workflow-docs-contract.cjs",
    "test:workflow-profile": "node qa/workflow-profile-contract.cjs",
    "test:browser": "node qa/browser-audit.cjs",
    "test:browser-contract": "node qa/browser-audit-contract.cjs",
    "test:ci-workflow": "node qa/ci-workflow-contract.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "miniflare": "5.20260916.0-alpha",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "4.133.0"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
