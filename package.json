{
  "name": "wd-marketing-premium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:turbo": "next dev --turbopack",
    "build": "next build && node scripts/build-worker.cjs",
    "start": "wrangler dev --config wrangler.generated.json",
    "typecheck": "tsc --noEmit",
    "test:backend": "node qa/contact-worker.cjs && node qa/contact-runtime.cjs",
    "test:deployment": "node qa/standalone.cjs",
    "configure:cloudflare": "node scripts/cloudflare-config.cjs",
    "deploy": "node scripts/deploy-cloudflare.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "15.5.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "miniflare": "4.20260730.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "4.131.0"
  }
}
